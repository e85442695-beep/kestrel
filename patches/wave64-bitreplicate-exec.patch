+    def test_bitreplicate_replaces_wave64_exec_and_preserves_scc(self):
+        asm = [
+            "s_mov_b64 exec, 0",
+            "s_cmp_eq_u32 s5, 0",
+            "s_bitreplicate_b64_b32 exec, s4",
+            "s_cselect_b32 s6, 1, 2",
+            "v_mov_b32 v5, s6",
+            "v_lshlrev_b32 v6, 2, v0",
+            "buffer_store_dword v5, v6, s[0:3], 0 offen",
+            "s_endpgm",
+        ]
+        spv = translate_cs("w64_bitreplicate_exec", asm, 64)
+        for word in (0, 0x80000001, 0x0F0F0F0F, M32):
+            for compare in (0, 1):
+                with self.subTest(word=word, compare=compare):
+                    mem = run_cs(spv, 64, s4=word, s5=compare)
+                    self.assertEqual([mem.get(4 * i, 0) for i in range(64)],
+                                     [(1 + compare) * (word >> (i // 2) & 1) for i in range(64)])
+
