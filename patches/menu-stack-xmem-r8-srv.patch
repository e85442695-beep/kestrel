+    ID3D12Resource* add_ref_texture_for_srv(std::uint64_t address, const D3D12_RESOURCE_DESC& shape) {
+        if (ID3D12Resource* existing = add_ref_texture_at(address)) return existing;
+        if (shape.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || shape.Format != DXGI_FORMAT_R8_UNORM ||
+            shape.DepthOrArraySize != 1 || shape.MipLevels != 1 || shape.SampleDesc.Count != 1 ||
+            shape.SampleDesc.Quality || !shape.Width || !shape.Height ||
+            shape.Width > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION || shape.Height > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION)
+            return nullptr;
+
+        const std::uint64_t bytes = shape.Width * shape.Height;
+        std::uint64_t lo = 0, hi = 0;
+        if (!leonida::title_va_aliases().title_memory(address, lo, hi) || bytes > hi - address) return nullptr;
+
+        const std::lock_guard lock(xmem_srv_texture_mutex_);
+        if (const auto it = xmem_srv_textures_.find(address); it != xmem_srv_textures_.end()) {
+            Resource* texture = it->second;
+            if (texture->desc().Width != shape.Width || texture->desc().Height != shape.Height) return nullptr;
+            texture->AddRef();
+            return texture;
+        }
+
+        constexpr std::uint64_t texture_budget = 16ull << 20;
+        if (bytes > texture_budget - xmem_srv_texture_bytes_) return nullptr;
+
+        D3D12_RESOURCE_DESC desc = shape;
+        desc.Alignment = 0;
+        desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+        desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+        const D3D12_HEAP_PROPERTIES heap{D3D12_HEAP_TYPE_CUSTOM, D3D12_CPU_PAGE_PROPERTY_WRITE_BACK,
+                                         D3D12_MEMORY_POOL_L0, 1, 1};
+        const Format format = state_.texture_format(desc);
+        if (format.format == VK_FORMAT_UNDEFINED) return nullptr;
+
+        // This internal image is owned by the device, so it doesn't take a COM reference back to it.
+        auto release = [](Resource* image) { image->Release(); };
+        std::unique_ptr<Resource, decltype(release)> texture(new Resource(state_, desc, heap, D3D12_HEAP_FLAG_NONE),
+                                                            release);
+        if (FAILED(texture->create_texture(format)) ||
+            !texture->attach_texture_pages(reinterpret_cast<void*>(static_cast<std::uintptr_t>(address)))) return nullptr;
+        xmem_srv_textures_.emplace(address, texture.get());
+        xmem_srv_texture_bytes_ += bytes;
+        texture->AddRef();
+        std::fprintf(stderr, "[rt] d3d12: slot 70 created an %llux%u R8_UNORM SRV texture over XMem\n",
+                     static_cast<unsigned long long>(desc.Width), desc.Height);
+        return texture.release();
+    }
