+    bool write_title_r16_srv(std::uint64_t va, std::uint64_t width, const D3D12_SHADER_RESOURCE_VIEW_DESC& view,
+                             D3D12_CPU_DESCRIPTOR_HANDLE destination) {
+        if (va % 2 || !destination.ptr) return false;
+        std::uint64_t range_start = 0, range_end = 0;
+        auto& aliases = leonida::title_va_aliases();
+        if (!aliases.title_memory(va, range_start, range_end)) return false;
+        std::uint64_t count = std::min(width, range_end - va) / 2;
+        if (view.Buffer.NumElements) count = std::min<std::uint64_t>(count, view.Buffer.NumElements);
+        if (!count || count > UINT32_MAX) return false;
+        const std::uint64_t bytes = count * 2;
+        const std::uint64_t address = vsharp_address(va, bytes);
+        if (address == va || address >= state_.arena.size || bytes > state_.arena.size - address ||
+            aliases.shader_va(va + bytes - 1) != address + bytes - 1) return false;
+
+        leonida::gfx10::Buffer buffer{};
+        buffer.address = address;
+        buffer.stride = 2;
+        buffer.num_records = static_cast<std::uint32_t>(count);
+        buffer.format = leonida::gfx10::format_from_vulkan(VK_FORMAT_R16_UINT);
+        set_typed_buffer_swizzle(buffer, VK_FORMAT_R16_UINT, view.Shader4ComponentMapping);
+        buffer.oob_select = leonida::gfx10::OobSelect::structured;
+        const leonida::gfx10::BufferWords words = leonida::gfx10::encode(buffer);
+        auto* const dest = reinterpret_cast<void*>(destination.ptr);
+        std::memset(dest, 0, kDescriptorSize);
+        std::memcpy(dest, words.data(), sizeof(words));
+        static std::once_flag logged;
+        std::call_once(logged, [] {
+            std::fprintf(stderr, "[rt] d3d12: Xbox slot 70 wrote an R16_UINT buffer view of the title's XMem\n");
+        });
+        return true;
+    }
+
+    static void set_typed_buffer_swizzle(leonida::gfx10::Buffer& buffer, VkFormat format, UINT mapping) {
+        const leonida::gfx10::Swizzle channels = leonida::gfx10::format_swizzle(format);
+        for (unsigned i = 0; i < 4; ++i) {
+            const UINT from = D3D12_DECODE_SHADER_4_COMPONENT_MAPPING(i, mapping);
+            buffer.swizzle[i] = from < 4 ? channels[from]
+                                : from == D3D12_SHADER_COMPONENT_MAPPING_FORCE_VALUE_0
+                                    ? leonida::gfx10::select_zero
+                                    : leonida::gfx10::select_one;
+        }
+    }
